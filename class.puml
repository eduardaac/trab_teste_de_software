@startuml AquarioClassDiagram

title Diagrama de Classes do Jogo do Aquário (Parte II)

class Main {
    + {static} main(String[] args): void
    ~ {static} executar(String[] args, InputStream in, PrintStream out): int
}

class Parametros {
    + {static} NOMES: String[]
    + {static} converter(String[] valores): int[]
    + {static} converterInteiro(String nome, String valor): int
    + {static} ler(Scanner entrada, PrintStream saida): int[]
}

class Game {
    - aquario: Aquario
    - entrada: Scanner
    - saida: PrintStream
    - pontuacao: int
    - encerradoPeloJogador: boolean
    + Game(Aquario aquario, Scanner entrada, PrintStream saida)
    + getPontuacao(): int
    + isFimDeJogo(): boolean
    + encerrar(): void
    + executarIteracao(): void
    + jogar(): int
    - desejaContinuar(): boolean
}

class Aquario {
    - linhas: int
    - colunas: int
    - matriz: IPeixe[][]
    - reproducaoA: int
    - mortalidadeA: int
    - reproducaoB: int
    - mortalidadeB: int
    - random: Random
    + Aquario(int m, int n, int ra, int ma, int rb, int mb, Random random)
    + Aquario(int m, int n, int x, int y, int ra, int ma, int rb, int mb, Random random)
    + getLinhas(): int
    + getColunas(): int
    + coordenadaValida(int linha, int coluna): boolean
    + getPeixe(int linha, int coluna): IPeixe
    + posicionarPeixe(int linha, int coluna, IPeixe peixe): boolean
    + removerPeixe(int linha, int coluna): IPeixe
    + contarPeixes(Tipo tipo): int
    + iterar(): void
    + toString(): String
    - agirPeixeA(PeixeA peixe, int i, int j): void
    - agirPeixeB(PeixeB peixe, int i, int j): void
    - adjacentes(int linha, int coluna, Tipo tipo): List<int[]>
}

enum Tipo {
    A
    B
}

abstract class IPeixe {
    - agiuNaIteracao: boolean
    + {abstract} getTipo(): Tipo
    + agiuNaIteracao(): boolean
}

class PeixeA extends IPeixe {
    - movimentosSeguidos: int
    - iteracoesParado: int
    + getMovimentosSeguidos(): int
    + getIteracoesParado(): int
}

class PeixeB extends IPeixe {
    - peixesComidos: int
    - iteracoesSemComer: int
    + getPeixesComidos(): int
    + getIteracoesSemComer(): int
}

Main ..> Parametros : usa
Main ..> Game : cria
Game "1" o-- "1" Aquario : controla
Aquario "1" *-- "0..*" IPeixe : contém
IPeixe ..> Tipo

@enduml
